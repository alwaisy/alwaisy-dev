---
import BaseLayout from '../layouts/base-layout.astro';
import 'country-flag-icons/3x2/flags.css';

export const prerender = false;
---

<BaseLayout
    title="Open Analytics"
    description="Public, transparent, privacy-first telemetry for alwaisy.dev powered by Cloudflare D1."
    showHeader={false}
    slug="analytics"
>
    <article class="mb-16 sm:mb-24">
        <!-- Page Header: Editorial & Restrained -->
        <header class="mb-10 pb-6 border-b border-main/15">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-muted">
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                            </span>
                            Live Telemetry
                        </span>
                    </div>
                    <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-main">
                        Open Analytics
                    </h1>
                    <p class="text-muted mt-2 text-sm sm:text-base max-w-xl">
                        Self-hosted, cookie-less telemetry and transparent visitor journeys on Cloudflare D1.
                    </p>
                </div>

                <!-- Live Status & User Persona Indicators -->
                <div class="flex items-center gap-2 shrink-0 font-mono text-xs">
                    <div
                        id="live-online-pill"
                        class="inline-flex items-center gap-2 rounded-lg border border-emerald-500/25 bg-emerald-500/10 px-3 py-1.5 text-emerald-800 dark:text-emerald-300"
                    >
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                        <span><strong id="live-online-count" class="font-semibold text-main">0</strong> online now</span>
                    </div>

                    <div
                        id="my-persona-pill"
                        class="hidden items-center gap-1.5 rounded-lg border border-main/15 bg-muted/20 px-3 py-1.5 text-main"
                    >
                        <span class="text-muted">You:</span>
                        <strong id="my-persona-name" class="font-semibold text-main">--</strong>
                    </div>
                </div>
            </div>
        </header>

        <!-- Loading Skeleton -->
        <div id="analytics-loading" class="space-y-8 animate-pulse">
            <div class="grid grid-cols-2 gap-px border border-main/15 bg-main/15 sm:grid-cols-4 rounded-xl overflow-hidden">
                <div class="h-28 bg-muted/20"></div>
                <div class="h-28 bg-muted/20"></div>
                <div class="h-28 bg-muted/20"></div>
                <div class="h-28 bg-muted/20"></div>
            </div>
            <div class="h-60 rounded-xl border border-main/15 bg-muted/15"></div>
            <div class="h-80 rounded-xl border border-main/15 bg-muted/15"></div>
        </div>

        <!-- Real Analytics Dashboard -->
        <div id="analytics-content" class="hidden space-y-10 sm:space-y-14">
            <!-- Filter & Action Bar: Unified Toolbar -->
            <div class="flex flex-wrap items-center justify-between gap-3">
                <!-- Time Range Segmented Control -->
                <div class="inline-flex items-center rounded-lg border border-main/20 bg-muted/30 p-0.5 text-xs font-mono">
                    <button
                        type="button"
                        data-timeframe="all"
                        class="timeframe-btn rounded-md px-3 py-1 font-medium transition-colors bg-main text-background shadow-xs cursor-pointer"
                    >
                        All Time
                    </button>
                    <button
                        type="button"
                        data-timeframe="30d"
                        class="timeframe-btn rounded-md px-3 py-1 font-medium transition-colors text-muted hover:text-main cursor-pointer"
                    >
                        30D
                    </button>
                    <button
                        type="button"
                        data-timeframe="7d"
                        class="timeframe-btn rounded-md px-3 py-1 font-medium transition-colors text-muted hover:text-main cursor-pointer"
                    >
                        7D
                    </button>
                    <button
                        type="button"
                        data-timeframe="today"
                        class="timeframe-btn rounded-md px-3 py-1 font-medium transition-colors text-muted hover:text-main cursor-pointer"
                    >
                        Today
                    </button>
                </div>

                <div class="flex items-center gap-3 text-xs font-mono text-muted">
                    <span id="filter-status-label" class="hidden sm:inline">All-time telemetry data</span>
                    
                    <button
                        type="button"
                        id="manual-refresh-btn"
                        class="inline-flex items-center gap-1.5 rounded-md border border-main/15 bg-muted/20 px-2.5 py-1 text-xs font-mono text-main hover:bg-main/10 hover:border-main/30 transition-all cursor-pointer"
                        title="Force refresh analytics directly from database"
                    >
                        <svg id="refresh-spinner" class="w-3.5 h-3.5 text-main transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                        <span id="refresh-btn-label">Refresh</span>
                    </button>
                </div>
            </div>

            <!-- 1. Key Performance Indicators: Unified Data Grid (Not 4 floating cards) -->
            <section aria-label="Key Performance Indicators">
                <div class="grid grid-cols-2 sm:grid-cols-4 border border-main/15 bg-muted/10 divide-x divide-y sm:divide-y-0 divide-main/15 rounded-xl overflow-hidden">
                    <div class="p-4 sm:p-6">
                        <p class="text-[11px] font-mono uppercase tracking-wider text-muted">Total Views</p>
                        <p id="stat-total-views" class="mt-2 font-mono text-2xl sm:text-3xl font-semibold text-main">0</p>
                        <p class="mt-1 text-[11px] font-mono text-muted/80">Page views</p>
                    </div>

                    <div class="p-4 sm:p-6">
                        <p class="text-[11px] font-mono uppercase tracking-wider text-muted">Unique Visitors</p>
                        <p id="stat-unique-visitors" class="mt-2 font-mono text-2xl sm:text-3xl font-semibold text-main">0</p>
                        <p class="mt-1 text-[11px] font-mono text-muted/80">Distinct personas</p>
                    </div>

                    <div class="p-4 sm:p-6">
                        <p class="text-[11px] font-mono uppercase tracking-wider text-muted">Top Country</p>
                        <p id="stat-top-country" class="mt-2 font-mono text-lg sm:text-2xl font-semibold text-main truncate">--</p>
                        <p class="mt-1 text-[11px] font-mono text-muted/80">Primary origin</p>
                    </div>

                    <div class="p-4 sm:p-6">
                        <p class="text-[11px] font-mono uppercase tracking-wider text-muted">Bounce Rate</p>
                        <p id="stat-bounce-rate" class="mt-2 font-mono text-2xl sm:text-3xl font-semibold text-main">0%</p>
                        <p class="mt-1 text-[11px] font-mono text-muted/80">Single-page journeys</p>
                    </div>
                </div>
            </section>

            <!-- 2. Continuous 14-Day Traffic Trend -->
            <section aria-label="Traffic Over Time" class="rounded-xl border border-main/15 bg-muted/10 p-5 sm:p-6">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
                    <div>
                        <h2 class="font-serif text-lg sm:text-xl font-medium text-main">Traffic Volume</h2>
                        <p class="text-xs font-mono text-muted mt-0.5">Daily page hits recorded across all routes</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                        <span class="text-xs font-mono text-muted">Daily hits</span>
                    </div>
                </div>

                <div class="relative pt-6">
                    <div id="chart-bars" class="flex h-36 items-end gap-1.5 sm:gap-2.5 border-b border-main/15 pb-1">
                        <!-- Populated with continuous 14-day bars -->
                    </div>
                    <div id="chart-labels" class="flex justify-between pt-2 text-[10px] font-mono text-muted">
                        <span id="chart-date-start">14 days ago</span>
                        <span id="chart-date-mid">7 days ago</span>
                        <span id="chart-date-end">Today</span>
                    </div>
                </div>
            </section>

            <!-- 3. Minimalist Visitor Journeys with Integrated Live Filter (Miller's Law) -->
            <section aria-label="Visitor Sessions">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <div class="flex items-center gap-3">
                            <h2 class="font-serif text-xl sm:text-2xl font-medium text-main">
                                Visitor Journeys
                            </h2>
                            <!-- Live pill filter -->
                            <button
                                type="button"
                                id="filter-live-toggle"
                                class="inline-flex items-center gap-1.5 rounded-md border border-emerald-500/25 bg-emerald-500/10 px-2 py-0.5 text-xs font-mono text-emerald-800 dark:text-emerald-300 hover:bg-emerald-500/20 transition-colors cursor-pointer"
                                title="Click to filter only active online visitors"
                            >
                                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                <span id="active-visitors-badge">0 Live Now</span>
                            </button>
                        </div>
                        <p class="text-xs text-muted font-mono mt-1">
                            Click any visitor to inspect their sequence and dwell duration.
                        </p>
                    </div>

                    <!-- Filter state indicator when active -->
                    <div id="live-filter-active-notice" class="hidden items-center gap-2 text-xs font-mono text-emerald-600 dark:text-emerald-400">
                        <span>Filtered by live active only</span>
                        <button id="clear-live-filter" class="underline hover:text-main text-[11px] cursor-pointer">Reset</button>
                    </div>
                </div>

                <!-- Minimal Table / Card List -->
                <div class="overflow-hidden rounded-xl border border-main/15 bg-muted/10">
                    <div class="hidden sm:grid sm:grid-cols-12 gap-3 px-4 py-2.5 border-b border-main/10 text-[11px] font-mono uppercase tracking-wider text-muted">
                        <div class="col-span-4">Visitor Persona</div>
                        <div class="col-span-3">Initial Route</div>
                        <div class="col-span-3">Origin & Device</div>
                        <div class="col-span-2 text-right">Activity · Time</div>
                    </div>

                    <div id="visitors-list" class="divide-y divide-main/10">
                        <!-- Compact interactive rows inserted here -->
                    </div>
                </div>
            </section>

            <!-- 4. Top Pages & Traffic Sources -->
            <section class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <!-- Top Pages -->
                <div class="rounded-xl border border-main/15 bg-muted/10 p-5 sm:p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-serif text-lg font-medium text-main">Top Pages</h3>
                        <span class="text-[11px] font-mono text-muted uppercase">Views</span>
                    </div>
                    <div id="top-pages-list" class="space-y-2.5">
                        <!-- Populated via script -->
                    </div>
                </div>

                <!-- Top Referrers -->
                <div class="rounded-xl border border-main/15 bg-muted/10 p-5 sm:p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-serif text-lg font-medium text-main">Referral Sources</h3>
                        <span class="text-[11px] font-mono text-muted uppercase">Hits</span>
                    </div>
                    <div id="top-referrers-list" class="space-y-1">
                        <!-- Populated via script -->
                    </div>
                </div>
            </section>

            <!-- 5. Geographical & Platform Breakdown -->
            <section class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <!-- Countries -->
                <div class="rounded-xl border border-main/15 bg-muted/10 p-5 sm:p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-serif text-lg font-medium text-main">Geography</h3>
                        <span class="text-[11px] font-mono text-muted uppercase">Sessions</span>
                    </div>
                    <div id="countries-list" class="space-y-1">
                        <!-- Populated via script -->
                    </div>
                </div>

                <!-- Devices & Browsers -->
                <div class="rounded-xl border border-main/15 bg-muted/10 p-5 sm:p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-serif text-lg font-medium text-main">Platforms</h3>
                        <span class="text-[11px] font-mono text-muted uppercase">Hits</span>
                    </div>
                    <div id="devices-list" class="space-y-1">
                        <!-- Populated via script -->
                    </div>
                </div>
            </section>
        </div>
    </article>

    <!-- Modal Dialog for Full Journey Inspection (Miller's Law) -->
    <dialog
        id="journey-modal"
        class="backdrop:bg-black/60 backdrop:backdrop-blur-xs rounded-xl border border-main/20 bg-main text-main p-0 max-w-xl w-[calc(100%-2rem)] fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 m-0 shadow-2xl overflow-hidden"
    >
        <div class="px-5 py-4 border-b border-main/15 flex items-center justify-between">
            <div>
                <div class="flex items-center gap-2">
                    <h3 id="modal-visitor-name" class="font-serif text-lg font-semibold text-main">Visitor Journey</h3>
                    <span id="modal-visitor-me" class="hidden rounded bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 font-mono text-[10px] px-2 py-0.5 font-bold uppercase">That's You</span>
                </div>
                <p id="modal-visitor-meta" class="text-xs text-muted font-mono mt-0.5">1 visit · 9 views · 13m 23s on site</p>
            </div>
            <button
                id="modal-close-btn"
                class="rounded-md p-1 text-muted hover:text-main hover:bg-muted/40 transition-colors cursor-pointer"
                aria-label="Close dialog"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <div class="p-5 max-h-[65vh] overflow-y-auto space-y-4">
            <div>
                <h4 class="text-[11px] font-mono uppercase tracking-wider text-muted mb-3">Navigation History</h4>
                <div id="modal-journey-steps" class="space-y-2 pl-3 border-l border-main/20 ml-1">
                    <!-- Populated dynamically -->
                </div>
            </div>

            <div class="pt-4 border-t border-main/10 flex flex-wrap gap-4 text-xs font-mono text-muted">
                <span id="modal-visitor-loc">Location: Unknown</span>
                <span id="modal-visitor-dev">Device: Desktop</span>
                <span id="modal-visitor-browser">Browser: Chrome</span>
            </div>
        </div>
    </dialog>

    <!-- Modal Dialog for Page Detail Inspection (Miller's Law) -->
    <dialog
        id="page-modal"
        class="backdrop:bg-black/60 backdrop:backdrop-blur-xs rounded-xl border border-main/20 bg-main text-main p-0 max-w-xl w-[calc(100%-2rem)] fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 m-0 shadow-2xl overflow-hidden"
    >
        <div class="px-5 py-4 border-b border-main/15 flex items-center justify-between">
            <div>
                <div class="flex items-center gap-2">
                    <h3 id="modal-page-path" class="font-mono font-semibold text-base text-main truncate max-w-[260px] sm:max-w-md">/</h3>
                </div>
                <p id="modal-page-title" class="text-xs text-muted truncate max-w-[260px] sm:max-w-md mt-0.5">Page Title</p>
            </div>
            <button
                id="modal-page-close-btn"
                class="rounded-md p-1 text-muted hover:text-main hover:bg-muted/40 transition-colors cursor-pointer"
                aria-label="Close page dialog"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <div class="p-5 max-h-[65vh] overflow-y-auto space-y-5">
            <!-- Key Page Metrics Grid -->
            <div class="grid grid-cols-3 border border-main/15 divide-x divide-main/15 rounded-lg overflow-hidden bg-muted/10">
                <div class="p-3 text-center">
                    <span class="text-[10px] font-mono text-muted uppercase">Views</span>
                    <p id="modal-page-views" class="text-lg sm:text-xl font-bold font-mono text-main mt-0.5">0</p>
                </div>
                <div class="p-3 text-center">
                    <span class="text-[10px] font-mono text-muted uppercase">Uniques</span>
                    <p id="modal-page-uniques" class="text-lg sm:text-xl font-bold font-mono text-main mt-0.5">0</p>
                </div>
                <div class="p-3 text-center">
                    <span class="text-[10px] font-mono text-muted uppercase">Avg Dwell</span>
                    <p id="modal-page-dwell" class="text-lg sm:text-xl font-bold font-mono text-main mt-0.5">0s</p>
                </div>
            </div>

            <!-- Recent Visitors to this Page -->
            <div>
                <h4 class="text-[11px] font-mono uppercase tracking-wider text-muted mb-2.5">Visitors on this Route</h4>
                <div id="modal-page-visitors" class="space-y-1.5">
                    <!-- Populated dynamically -->
                </div>
            </div>

            <div class="pt-4 border-t border-main/10 flex items-center justify-between text-xs font-mono text-muted">
                <a id="modal-page-live-link" href="#" target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1">
                    <span>Visit Live Page</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                </a>
                <span class="text-[11px] opacity-70">Filtered by selected timeframe</span>
            </div>
        </div>
    </dialog>

    <script>
        interface Step {
            id: number;
            path: string;
            title: string;
            referrer: string;
            stepOrder: number;
            dwellTimeSeconds: number;
            createdAt: number;
        }

        interface Visitor {
            id: string;
            personaName: string;
            personaAlias: string;
            personaBadgeColor: string;
            personaEmoji: string;
            firstSeen: number;
            lastSeen: number;
            visitCount: number;
            totalPageViews: number;
            lastCountry: string;
            lastDevice: string;
            lastBrowser: string;
            journey: Step[];
        }

        interface TrendDay {
            date: string;
            label: string;
            views: number;
        }

        interface PageStat {
            path: string;
            views: number;
            uniqueVisitors?: number;
            avgDwellSeconds?: number;
            title?: string;
        }

        interface RealtimeVisitor {
            id: string;
            personaName: string;
            personaAlias?: string;
            personaBadgeColor?: string;
            lastCountry?: string;
            lastDevice?: string;
            lastBrowser?: string;
            currentPath: string;
            currentTitle?: string;
            dwellTimeSeconds: number;
            secondsAgo: number;
        }

        interface AnalyticsPayload {
            summary: {
                totalPageViews: number;
                uniqueVisitors: number;
                returningVisitors: number;
                topCountry: string;
                topCountryCode?: string;
                bounceRate: string;
                onlineCount?: number;
            };
            visitors: Visitor[];
            activeVisitors?: RealtimeVisitor[];
            topPages: PageStat[];
            topReferrers: Array<{ referrer: string; count: number }>;
            countries: Array<{ country: string; count: number }>;
            devices: Array<{ device: string; count: number }>;
            dailyTrends: TrendDay[];
        }

        let allVisitors: Visitor[] = [];
        let activeVisitorsList: RealtimeVisitor[] = [];
        let allPages: PageStat[] = [];
        let onlyLiveFilter = false;

        function formatTimeAgo(timestamp: number): string {
            const diff = Math.max(0, Math.floor((Date.now() - timestamp) / 1000));
            if (diff < 60) return `${diff}s ago`;
            if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
            if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
            return `${Math.floor(diff / 86400)}d ago`;
        }

        function updateMyPersonaPill() {
            const personaName = localStorage.getItem('mid_persona_name');

            if (personaName) {
                const pill = document.getElementById('my-persona-pill');
                const elName = document.getElementById('my-persona-name');

                if (elName) elName.textContent = personaName;
                if (pill) {
                    pill.classList.remove('hidden');
                    pill.classList.add('inline-flex');
                }
            }
        }

        function renderFlag(code?: string): string {
            if (!code || code === 'Unknown' || code === '--') return '';
            const c = code.trim().toUpperCase();
            if (/^[A-Z]{2}$/.test(c)) {
                return `<span class="flag:${c} inline-block align-middle rounded-xs shadow-xs shrink-0" style="width: 1.1em; height: 0.73em;"></span>`;
            }
            return '';
        }

        function openJourneyModal(visitorId: string) {
            const visitor = allVisitors.find(v => v.id === visitorId);
            if (!visitor) return;

            const modal = document.getElementById('journey-modal') as HTMLDialogElement | null;
            if (!modal) return;

            const myVisitorId = localStorage.getItem('mid_v_id');
            const isMe = myVisitorId && visitor.id === myVisitorId;

            const nameEl = document.getElementById('modal-visitor-name');
            const meBadge = document.getElementById('modal-visitor-me');
            const metaEl = document.getElementById('modal-visitor-meta');
            const stepsEl = document.getElementById('modal-journey-steps');
            const locEl = document.getElementById('modal-visitor-loc');
            const devEl = document.getElementById('modal-visitor-dev');
            const browserEl = document.getElementById('modal-visitor-browser');

            if (nameEl) nameEl.textContent = visitor.personaName;
            if (meBadge) {
                if (isMe) meBadge.classList.remove('hidden');
                else meBadge.classList.add('hidden');
            }

            const totalDwell = visitor.journey ? visitor.journey.reduce((acc, s) => acc + (s.dwellTimeSeconds || 0), 0) : 0;
            const dwellStr = totalDwell > 60 ? `${Math.floor(totalDwell / 60)}m ${totalDwell % 60}s` : `${totalDwell}s`;

            if (metaEl) {
                metaEl.textContent = `${visitor.visitCount} ${visitor.visitCount === 1 ? 'visit' : 'visits'} · ${visitor.totalPageViews} views · ${dwellStr} total dwell`;
            }
            if (locEl) {
                const flagHtml = renderFlag(visitor.lastCountry);
                locEl.innerHTML = `${flagHtml ? flagHtml + ' ' : ''}<span>${visitor.lastCountry || 'Unknown'}</span>`;
            }
            if (devEl) devEl.textContent = `💻 ${visitor.lastDevice || 'Desktop'}`;
            if (browserEl) browserEl.textContent = `🌐 ${visitor.lastBrowser || 'Web'}`;

            if (stepsEl) {
                stepsEl.innerHTML = '';
                if (!visitor.journey || visitor.journey.length === 0) {
                    stepsEl.innerHTML = '<p class="text-xs text-muted">No steps recorded.</p>';
                } else {
                    visitor.journey.forEach((step) => {
                        const stepRow = document.createElement('div');
                        stepRow.className = 'relative flex items-start justify-between gap-3 text-xs';
                        stepRow.innerHTML = `
                            <div class="absolute -left-[21px] top-1 h-2.5 w-2.5 rounded-full border border-main bg-main"></div>
                            <div>
                                <span class="font-mono font-medium text-main">${step.path}</span>
                                ${step.title && step.title !== step.path ? `<p class="text-[11px] text-muted truncate max-w-xs">${step.title}</p>` : ''}
                            </div>
                            <div class="text-right font-mono text-[11px] text-muted whitespace-nowrap">
                                <span>${step.dwellTimeSeconds > 0 ? `${step.dwellTimeSeconds}s` : 'entry'}</span>
                                <span class="text-[10px] opacity-70 block">${formatTimeAgo(step.createdAt)}</span>
                            </div>
                        `;
                        stepsEl.appendChild(stepRow);
                    });
                }
            }

            modal.showModal();
        }

        function openPageModal(pagePath: string) {
            const page = allPages.find(p => p.path === pagePath);
            const modal = document.getElementById('page-modal') as HTMLDialogElement | null;
            if (!modal) return;

            const pathEl = document.getElementById('modal-page-path');
            const titleEl = document.getElementById('modal-page-title');
            const viewsEl = document.getElementById('modal-page-views');
            const uniquesEl = document.getElementById('modal-page-uniques');
            const dwellEl = document.getElementById('modal-page-dwell');
            const visitorsEl = document.getElementById('modal-page-visitors');
            const linkEl = document.getElementById('modal-page-live-link') as HTMLAnchorElement | null;

            if (pathEl) pathEl.textContent = pagePath;
            if (titleEl) titleEl.textContent = page?.title || pagePath;
            if (viewsEl) viewsEl.textContent = (page?.views || 0).toLocaleString();
            if (uniquesEl) uniquesEl.textContent = (page?.uniqueVisitors || 0).toLocaleString();
            if (dwellEl) {
                const sec = page?.avgDwellSeconds || 0;
                dwellEl.textContent = sec > 60 ? `${Math.floor(sec / 60)}m ${sec % 60}s` : `${sec}s`;
            }
            if (linkEl) linkEl.href = pagePath.startsWith('/') ? pagePath : `/${pagePath}`;

            // Find all visitors who have visited this page in their journey
            if (visitorsEl) {
                visitorsEl.innerHTML = '';
                const visitorsOnPage = allVisitors.filter(v => 
                    v.journey && v.journey.some(step => step.path === pagePath || step.path === `/${pagePath}` || `/${step.path}` === pagePath)
                );

                if (visitorsOnPage.length === 0) {
                    visitorsEl.innerHTML = '<p class="text-xs text-muted font-mono py-2">No visitor sessions recorded for this page in this timeframe.</p>';
                } else {
                    visitorsOnPage.slice(0, 8).forEach(v => {
                        const row = document.createElement('div');
                        row.className = 'flex items-center justify-between p-2.5 rounded-lg border border-main/10 bg-muted/10 text-xs font-mono transition-colors hover:bg-main/5 cursor-pointer';
                        row.onclick = () => {
                            modal.close();
                            openJourneyModal(v.id);
                        };

                        const flagHtml = renderFlag(v.lastCountry);
                        row.innerHTML = `
                            <div class="flex items-center gap-2 truncate">
                                <span class="font-medium text-main truncate">${v.personaName}</span>
                                <span class="text-muted text-[11px] flex items-center gap-1">${flagHtml} ${v.lastCountry || 'Unknown'}</span>
                            </div>
                            <span class="text-[11px] text-muted shrink-0">${formatTimeAgo(v.lastSeen)}</span>
                        `;
                        visitorsEl.appendChild(row);
                    });
                }
            }

            modal.showModal();
        }

        function renderVisitorsList() {
            const visitorsContainer = document.getElementById('visitors-list');
            if (!visitorsContainer) return;

            const myVisitorId = localStorage.getItem('mid_v_id');
            const activeIdMap = new Map<string, RealtimeVisitor>();
            activeVisitorsList.forEach(av => activeIdMap.set(av.id, av));

            // If onlyLiveFilter is toggled on, show only online visitors
            const listToShow = onlyLiveFilter
                ? allVisitors.filter(v => activeIdMap.has(v.id))
                : allVisitors;

            const activeNotice = document.getElementById('live-filter-active-notice');
            if (activeNotice) {
                if (onlyLiveFilter) activeNotice.classList.remove('hidden'), activeNotice.classList.add('flex');
                else activeNotice.classList.add('hidden'), activeNotice.classList.remove('flex');
            }

            visitorsContainer.innerHTML = '';
            if (listToShow.length === 0) {
                visitorsContainer.innerHTML = `
                    <div class="p-6 text-center text-sm font-mono text-muted">
                        ${onlyLiveFilter ? 'No visitors currently active online. Click "Show All" to view recent journeys.' : 'No visitor journeys captured yet.'}
                    </div>
                `;
                return;
            }

            listToShow.forEach((v) => {
                const isMe = myVisitorId && v.id === myVisitorId;
                const activeData = activeIdMap.get(v.id);
                const isLive = Boolean(activeData);

                const totalDwell = v.journey ? v.journey.reduce((acc, step) => acc + (step.dwellTimeSeconds || 0), 0) : 0;
                const dwellStr = totalDwell > 60 ? `${Math.floor(totalDwell / 60)}m` : `${totalDwell}s`;
                
                // Show currently active page if live, or initial route if past
                const currentRoute = isLive && activeData
                    ? activeData.currentPath
                    : (v.journey && v.journey[0] ? v.journey[0].path : '/home');

                const row = document.createElement('div');
                row.className = `group flex flex-col sm:grid sm:grid-cols-12 gap-2 sm:gap-3 px-4 py-3 cursor-pointer transition-colors hover:bg-main/5 ${
                    isLive ? 'bg-emerald-500/5' : ''
                }`;
                row.onclick = () => openJourneyModal(v.id);

                const initials = v.personaName ? v.personaName.split(' ').map(n => n[0]).join('').slice(0, 2) : 'V';
                const flagHtml = renderFlag(v.lastCountry);

                row.innerHTML = `
                    <div class="sm:col-span-4 flex items-center gap-2.5 min-w-0">
                        <div class="relative shrink-0">
                            <div class="w-7 h-7 rounded-full bg-main/10 border border-main/15 flex items-center justify-center font-mono text-xs font-semibold text-main">
                                ${initials}
                            </div>
                            ${isLive ? `
                                <span class="absolute -top-0.5 -right-0.5 flex h-2.5 w-2.5">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500 border border-background"></span>
                                </span>
                            ` : ''}
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <span class="font-medium text-sm text-main truncate max-w-full">${v.personaName}</span>
                                ${isMe ? '<span class="rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono text-[9px] px-1.5 py-0.2 font-bold shrink-0">YOU</span>' : ''}
                                ${isLive ? '<span class="rounded bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 font-mono text-[9px] px-1.5 py-0.2 font-semibold shrink-0">LIVE</span>' : ''}
                            </div>
                            <span class="text-[11px] text-muted font-mono sm:hidden flex items-center gap-1.5 mt-0.5">
                                ${flagHtml} <span>${v.lastCountry || 'Unknown'} · ${v.lastDevice || 'Desktop'}</span>
                            </span>
                        </div>
                    </div>

                    <div class="sm:col-span-3 flex items-center min-w-0">
                        <span class="font-mono text-xs ${isLive ? 'text-emerald-700 dark:text-emerald-300 font-medium' : 'text-muted'} truncate max-w-full" title="${currentRoute}">
                            ${currentRoute}
                            ${!isLive && v.journey && v.journey.length > 1 ? `<span class="text-[10px] text-muted/70 ml-1">(+${v.journey.length - 1} more)</span>` : ''}
                        </span>
                    </div>

                    <div class="hidden sm:flex sm:col-span-3 items-center text-xs font-mono text-muted gap-1.5 min-w-0">
                        ${flagHtml} <span class="truncate">${v.lastCountry || 'Unknown'} · ${v.lastDevice || 'Desktop'}</span>
                    </div>

                    <div class="sm:col-span-2 flex items-center justify-between sm:justify-end gap-2 text-xs font-mono text-muted whitespace-nowrap">
                        <span class="rounded bg-muted/60 px-2 py-0.5 border border-main/10 text-main" title="Total page dwell: ${dwellStr}">
                            ${v.visitCount}v · ${v.totalPageViews}p (${dwellStr})
                        </span>
                        <span>${isLive ? '<strong class="text-emerald-600 dark:text-emerald-400 font-semibold">online</strong>' : formatTimeAgo(v.lastSeen)}</span>
                    </div>
                `;
                visitorsContainer.appendChild(row);
            });
        }

        let currentTimeframe = 'all';

        function setTimeframe(newTimeframe: string) {
            currentTimeframe = newTimeframe;

            // Update button styles
            const buttons = document.querySelectorAll('.timeframe-btn');
            buttons.forEach(btn => {
                const btnTf = btn.getAttribute('data-timeframe');
                if (btnTf === currentTimeframe) {
                    btn.className = 'timeframe-btn rounded-lg px-3 py-1.5 font-medium transition-colors bg-main text-background shadow-xs';
                } else {
                    btn.className = 'timeframe-btn rounded-lg px-3 py-1.5 font-medium transition-colors text-muted hover:text-main';
                }
            });

            const statusLabel = document.getElementById('filter-status-label');
            if (statusLabel) {
                if (currentTimeframe === 'today') statusLabel.textContent = "Today's telemetry";
                else if (currentTimeframe === '7d') statusLabel.textContent = "Last 7 days telemetry";
                else if (currentTimeframe === '30d') statusLabel.textContent = "Last 30 days telemetry";
                else statusLabel.textContent = "All-time telemetry data";
            }

            loadAnalyticsDashboard(currentTimeframe);
        }

        async function loadAnalyticsDashboard(timeframe = currentTimeframe, forceRefresh = false) {
            updateMyPersonaPill();

            const refreshBtn = document.getElementById('manual-refresh-btn') as HTMLButtonElement | null;
            const refreshSpinner = document.getElementById('refresh-spinner');
            const refreshLabel = document.getElementById('refresh-btn-label');

            if (forceRefresh) {
                if (refreshBtn) refreshBtn.disabled = true;
                if (refreshSpinner) refreshSpinner.classList.add('animate-spin');
                if (refreshLabel) refreshLabel.textContent = 'Updating...';
            }

            try {
                const endpoint = forceRefresh
                    ? `/api/telemetry/stats?timeframe=${encodeURIComponent(timeframe)}&fresh=true&_t=${Date.now()}`
                    : `/api/telemetry/stats?timeframe=${encodeURIComponent(timeframe)}`;

                const res = await fetch(endpoint);
                if (!res.ok) throw new Error('Failed to load stats');
                const data: AnalyticsPayload = await res.json();
                allVisitors = data.visitors || [];
                allPages = data.topPages || [];

                // 1. KPI Cards
                const totalViews = data.summary.totalPageViews;
                const uniqueVisitors = data.summary.uniqueVisitors;

                const elTotal = document.getElementById('stat-total-views');
                if (elTotal) elTotal.textContent = totalViews.toLocaleString();

                const elUnique = document.getElementById('stat-unique-visitors');
                if (elUnique) elUnique.textContent = uniqueVisitors.toLocaleString();

                const elTopCountry = document.getElementById('stat-top-country');
                if (elTopCountry) {
                    const countryText = data.summary.topCountry || '--';
                    const countryCode = data.summary.topCountryCode || (countryText.split(' ')[0] || '');
                    const flagHtml = renderFlag(countryCode);
                    elTopCountry.innerHTML = `${flagHtml ? flagHtml + ' ' : ''}<span>${countryText}</span>`;
                }

                const elBounce = document.getElementById('stat-bounce-rate');
                if (elBounce) elBounce.textContent = data.summary.bounceRate || '0%';

                // 2. Render Full 14-Day Continuous Chart Bars
                const chartContainer = document.getElementById('chart-bars');
                if (chartContainer && data.dailyTrends && data.dailyTrends.length > 0) {
                    chartContainer.innerHTML = '';
                    const maxDaily = Math.max(...(data.dailyTrends.map(t => t.views)), 1);

                    data.dailyTrends.forEach((trend, idx) => {
                        const isToday = idx === data.dailyTrends.length - 1;
                        const heightPercent = trend.views > 0 
                            ? Math.max(12, Math.round((trend.views / maxDaily) * 100))
                            : 4;

                        const barColor = trend.views > 0
                            ? (isToday ? 'bg-emerald-500' : 'bg-main/40 group-hover:bg-emerald-500')
                            : 'bg-main/10 group-hover:bg-main/20';

                        const col = document.createElement('div');
                        col.className = 'group relative flex-1 flex flex-col items-center h-full justify-end cursor-pointer';
                        col.innerHTML = `
                            <div class="w-full rounded-t ${barColor} transition-all duration-300" style="height: ${heightPercent}%"></div>
                            <div class="pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity absolute -top-12 z-20 flex flex-col items-center">
                                <div class="rounded-md bg-main px-2 py-1 text-[11px] font-mono text-black dark:text-white shadow-lg whitespace-nowrap">
                                    <span class="font-bold">${trend.views}</span> views · ${trend.label}
                                </div>
                                <div class="h-1 w-1 border-4 border-transparent border-t-main"></div>
                            </div>
                        `;
                        chartContainer.appendChild(col);
                    });

                    const startLabel = document.getElementById('chart-date-start');
                    const midLabel = document.getElementById('chart-date-mid');
                    const endLabel = document.getElementById('chart-date-end');
                    if (startLabel && data.dailyTrends[0]) startLabel.textContent = data.dailyTrends[0].label;
                    if (midLabel && data.dailyTrends[6]) midLabel.textContent = data.dailyTrends[6].label;
                    if (endLabel && data.dailyTrends[13]) endLabel.textContent = `${data.dailyTrends[13].label} (Today)`;
                }

                // Update live online count in header pill & section toggle badge
                const onlineCount = data.summary.onlineCount ?? (data.activeVisitors ? data.activeVisitors.length : 0);
                const elLiveCount = document.getElementById('live-online-count');
                if (elLiveCount) elLiveCount.textContent = onlineCount.toString();

                const activeBadge = document.getElementById('active-visitors-badge');
                if (activeBadge) activeBadge.textContent = `${onlineCount} Live Now`;

                activeVisitorsList = data.activeVisitors || [];

                // 3. Compact Minimalist Visitor Sessions (Miller's Law)
                renderVisitorsList();

                // 4. Render Top Pages with percentage bars & clickable detail modal
                const topPagesContainer = document.getElementById('top-pages-list');
                if (topPagesContainer) {
                    topPagesContainer.innerHTML = '';
                    const maxViews = Math.max(...(data.topPages.map(p => p.views)), 1);
                    data.topPages.forEach(page => {
                        const pct = Math.round((page.views / maxViews) * 100);
                        const row = document.createElement('div');
                        row.className = 'group p-2 rounded-lg transition-colors hover:bg-main/5 cursor-pointer space-y-1.5';
                        row.onclick = () => openPageModal(page.path);
                        row.innerHTML = `
                            <div class="flex justify-between items-center text-xs font-mono">
                                <span class="text-main font-medium truncate max-w-[200px] sm:max-w-xs group-hover:underline flex items-center gap-1.5">
                                    <span>${page.path}</span>
                                    <svg class="w-3 h-3 opacity-0 group-hover:opacity-60 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                    </svg>
                                </span>
                                <div class="flex items-center gap-2">
                                    ${page.uniqueVisitors ? `<span class="text-[10px] text-muted">${page.uniqueVisitors}u</span>` : ''}
                                    <span class="text-main font-medium">${page.views.toLocaleString()}</span>
                                </div>
                            </div>
                            <div class="h-1 w-full bg-muted/40 rounded-full overflow-hidden">
                                <div class="h-full bg-main/50 rounded-full group-hover:bg-main/80 transition-colors" style="width: ${pct}%"></div>
                            </div>
                        `;
                        topPagesContainer.appendChild(row);
                    });
                }

                // 5. Render Top Referrers
                const referrersContainer = document.getElementById('top-referrers-list');
                if (referrersContainer) {
                    referrersContainer.innerHTML = '';
                    if (data.topReferrers.length === 0) {
                        referrersContainer.innerHTML = '<p class="text-xs font-mono text-muted py-2">Direct traffic only</p>';
                    } else {
                        data.topReferrers.forEach(ref => {
                            const row = document.createElement('div');
                            row.className = 'flex justify-between items-center text-xs font-mono py-1.5 border-b border-main/10 last:border-b-0';
                            row.innerHTML = `
                                <span class="text-main truncate max-w-[200px]">${ref.referrer}</span>
                                <span class="text-muted font-mono">${ref.count}</span>
                            `;
                            referrersContainer.appendChild(row);
                        });
                    }
                }

                // 6. Render Countries & Devices
                const countriesContainer = document.getElementById('countries-list');
                if (countriesContainer) {
                    countriesContainer.innerHTML = '';
                    if (data.countries.length === 0) {
                        countriesContainer.innerHTML = '<p class="text-xs font-mono text-muted py-2">No data recorded</p>';
                    } else {
                        data.countries.forEach(c => {
                            const flagHtml = renderFlag(c.country);
                            const row = document.createElement('div');
                            row.className = 'flex justify-between items-center text-xs font-mono py-1.5 border-b border-main/10 last:border-b-0';
                            row.innerHTML = `
                                <span class="text-main flex items-center gap-2">
                                    ${flagHtml}
                                    <span>${c.country}</span>
                                </span>
                                <span class="text-muted font-mono">${c.count}</span>
                            `;
                            countriesContainer.appendChild(row);
                        });
                    }
                }

                const devicesContainer = document.getElementById('devices-list');
                if (devicesContainer) {
                    devicesContainer.innerHTML = '';
                    if (data.devices.length === 0) {
                        devicesContainer.innerHTML = '<p class="text-xs font-mono text-muted py-2">No platform telemetry</p>';
                    } else {
                        data.devices.forEach(d => {
                            const row = document.createElement('div');
                            row.className = 'flex justify-between items-center text-xs font-mono py-1.5 border-b border-main/10 last:border-b-0';
                            row.innerHTML = `
                                <span class="text-main">${d.device}</span>
                                <span class="text-muted font-mono">${d.count}</span>
                            `;
                            devicesContainer.appendChild(row);
                        });
                    }
                }

                // Show Content
                const loadingEl = document.getElementById('analytics-loading');
                const contentEl = document.getElementById('analytics-content');
                if (loadingEl) loadingEl.classList.add('hidden');
                if (contentEl) contentEl.classList.remove('hidden');

            } catch (err) {
                const loadingEl = document.getElementById('analytics-loading');
                if (loadingEl) {
                    loadingEl.innerHTML = `
                        <div class="rounded-xl border border-red-500/20 bg-red-500/10 p-6 text-center text-sm text-red-600 dark:text-red-400">
                            Failed to load analytics: ${err instanceof Error ? err.message : String(err)}
                        </div>
                    `;
                }
            } finally {
                if (forceRefresh) {
                    setTimeout(() => {
                        if (refreshBtn) refreshBtn.disabled = false;
                        if (refreshSpinner) refreshSpinner.classList.remove('animate-spin');
                        if (refreshLabel) refreshLabel.textContent = 'Refresh';
                    }, 400);
                }
            }
        }

        // Modal close handlers
        const closeBtn = document.getElementById('modal-close-btn');
        const modal = document.getElementById('journey-modal') as HTMLDialogElement | null;
        if (closeBtn && modal) {
            closeBtn.onclick = () => modal.close();
            modal.onclick = (e) => {
                if (e.target === modal) modal.close();
            };
        }

        const pageCloseBtn = document.getElementById('modal-page-close-btn');
        const pageModal = document.getElementById('page-modal') as HTMLDialogElement | null;
        if (pageCloseBtn && pageModal) {
            pageCloseBtn.onclick = () => pageModal.close();
            pageModal.onclick = (e) => {
                if (e.target === pageModal) pageModal.close();
            };
        }

        // Listen for persona-ready event from tracker
        window.addEventListener('mid:persona-ready', () => {
            updateMyPersonaPill();
        });

        // Attach timeframe filter button click handlers
        function initTimeframeButtons() {
            const buttons = document.querySelectorAll('.timeframe-btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const tf = btn.getAttribute('data-timeframe');
                    if (tf && tf !== currentTimeframe) {
                        setTimeframe(tf);
                    }
                });
            });

            // Live filter toggle
            const liveToggle = document.getElementById('filter-live-toggle');
            if (liveToggle) {
                liveToggle.onclick = () => {
                    onlyLiveFilter = !onlyLiveFilter;
                    if (onlyLiveFilter) {
                        liveToggle.classList.remove('bg-emerald-500/10', 'text-emerald-700', 'dark:text-emerald-300');
                        liveToggle.classList.add('bg-emerald-500', 'text-black', 'font-bold');
                    } else {
                        liveToggle.classList.remove('bg-emerald-500', 'text-black', 'font-bold');
                        liveToggle.classList.add('bg-emerald-500/10', 'text-emerald-700', 'dark:text-emerald-300');
                    }
                    renderVisitorsList();
                };
            }

            const clearLiveBtn = document.getElementById('clear-live-filter');
            if (clearLiveBtn) {
                clearLiveBtn.onclick = () => {
                    onlyLiveFilter = false;
                    if (liveToggle) {
                        liveToggle.classList.remove('bg-emerald-500', 'text-black', 'font-bold');
                        liveToggle.classList.add('bg-emerald-500/10', 'text-emerald-700', 'dark:text-emerald-300');
                    }
                    renderVisitorsList();
                };
            }

            // Manual refresh button
            const manualRefreshBtn = document.getElementById('manual-refresh-btn');
            if (manualRefreshBtn) {
                manualRefreshBtn.onclick = () => {
                    loadAnalyticsDashboard(currentTimeframe, true);
                };
            }
        }

        // Run when page loads & set up live polling
        let livePollTimer: ReturnType<typeof setInterval> | null = null;

        document.addEventListener('astro:page-load', () => {
            if (window.location.pathname === '/analytics' || window.location.pathname === '/analytics/') {
                initTimeframeButtons();
                loadAnalyticsDashboard();

                if (livePollTimer) clearInterval(livePollTimer);
                // Poll every 15 seconds to keep the real-time active users and dwell seconds live
                livePollTimer = setInterval(() => {
                    // Only refresh if page is visible
                    if (document.visibilityState === 'visible') {
                        loadAnalyticsDashboard();
                    }
                }, 15000);
            } else if (livePollTimer) {
                clearInterval(livePollTimer);
                livePollTimer = null;
            }
        });

        document.addEventListener('astro:before-swap', () => {
            if (livePollTimer) {
                clearInterval(livePollTimer);
                livePollTimer = null;
            }
        });
    </script>
</BaseLayout>
