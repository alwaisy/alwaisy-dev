---
import BaseLayout from '../layouts/base-layout.astro';

export const prerender = false;
---

<BaseLayout
    title="Open Analytics & Citizen Journeys"
    description="Public, transparent, zero-cookie analytics and visitor journeys for alwaisy.dev, powered by Cloudflare D1 and The Middle shenanigans."
    showHeader={false}
    slug="analytics"
>
    <article class="mb-16 sm:mb-24">
        <!-- Page Header -->
        <header class="mb-8">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                    <h1 class="font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">
                        Open Analytics
                    </h1>
                    <p class="text-muted mt-2 text-base sm:text-lg">
                        100% self-hosted, privacy-first telemetry & visitor journeys powered by Cloudflare D1.
                    </p>
                </div>
                <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-emerald-500/10 px-3 py-1 text-xs font-mono text-emerald-700 dark:text-emerald-300">
                    <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Live Telemetry
                </div>
            </div>
        </header>

        <!-- Current Visitor Persona Greeting Card -->
        <section
            id="my-persona-card"
            class="mb-10 rounded-2xl border border-emerald-500/30 bg-emerald-500/5 p-4 sm:p-5 transition-all"
        >
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <span id="my-persona-emoji" class="text-3xl">🪥</span>
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-xs font-mono uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-semibold">Your Persona</span>
                            <span class="text-muted text-xs">·</span>
                            <h2 id="my-persona-name" class="font-semibold text-main text-base sm:text-lg">Detecting identity...</h2>
                        </div>
                        <p id="my-persona-quote" class="text-xs italic text-muted mt-0.5">Assigned deterministically from The Middle sitcom shenanigans</p>
                    </div>
                </div>
                <div class="text-xs font-mono text-muted flex sm:flex-col items-center sm:items-end justify-between">
                    <span class="rounded bg-muted/60 px-2 py-0.5 border border-main/10 text-main font-medium">You are in Session #1</span>
                    <span class="text-[11px] mt-0.5">Zero tracking cookies used</span>
                </div>
            </div>
        </section>

        <!-- Loading Skeleton -->
        <div id="analytics-loading" class="space-y-8 animate-pulse">
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div class="h-24 rounded-xl border border-main/15 bg-muted/20"></div>
                <div class="h-24 rounded-xl border border-main/15 bg-muted/20"></div>
                <div class="h-24 rounded-xl border border-main/15 bg-muted/20"></div>
                <div class="h-24 rounded-xl border border-main/15 bg-muted/20"></div>
            </div>
            <div class="h-64 rounded-xl border border-main/15 bg-muted/20"></div>
            <div class="h-80 rounded-xl border border-main/15 bg-muted/20"></div>
        </div>

        <!-- Real Analytics Container -->
        <div id="analytics-content" class="hidden space-y-12 sm:space-y-16">
            <!-- 1. Key Stat Metrics Cards -->
            <section aria-label="Key Performance Indicators" class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
                <div class="rounded-xl border border-main/15 bg-muted/20 p-4 sm:p-5">
                    <p class="text-xs font-mono uppercase tracking-wider text-muted">Total Views</p>
                    <p id="stat-total-views" class="mt-1 font-serif text-2xl font-bold sm:text-3xl text-main">0</p>
                    <p class="mt-1 text-[11px] text-muted">All-time page hits</p>
                </div>

                <div class="rounded-xl border border-main/15 bg-muted/20 p-4 sm:p-5">
                    <p class="text-xs font-mono uppercase tracking-wider text-muted">Unique Visitors</p>
                    <p id="stat-unique-visitors" class="mt-1 font-serif text-2xl font-bold sm:text-3xl text-main">0</p>
                    <p class="mt-1 text-[11px] text-muted">Distinct humans</p>
                </div>

                <div class="rounded-xl border border-main/15 bg-muted/20 p-4 sm:p-5">
                    <p class="text-xs font-mono uppercase tracking-wider text-muted">Returning Rate</p>
                    <p id="stat-returning-rate" class="mt-1 font-serif text-2xl font-bold sm:text-3xl text-main">0%</p>
                    <p id="stat-returning-sub" class="mt-1 text-[11px] text-muted">0 repeat visitors</p>
                </div>

                <div class="rounded-xl border border-main/15 bg-muted/20 p-4 sm:p-5">
                    <p class="text-xs font-mono uppercase tracking-wider text-muted">Top Persona</p>
                    <p id="stat-top-persona" class="mt-1 font-serif text-lg font-bold sm:text-xl text-main truncate">--</p>
                    <p class="mt-1 text-[11px] text-muted">Most common citizen</p>
                </div>
            </section>

            <!-- 2. Robust 14-Day Traffic Chart -->
            <section aria-label="Traffic Over Time" class="rounded-2xl border border-main/15 bg-muted/10 p-5 sm:p-6">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
                    <div>
                        <h2 class="font-serif text-lg font-semibold sm:text-xl text-main">14-Day Traffic Trend</h2>
                        <p class="text-xs text-muted">Continuous daily page views across all routes</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                        <span class="text-xs font-mono text-muted">Views per day</span>
                    </div>
                </div>

                <!-- Chart Grid with Height and Zero-Filled Bars -->
                <div class="relative pt-6">
                    <div id="chart-bars" class="flex h-44 items-end gap-1.5 sm:gap-2.5 border-b border-main/15 pb-1">
                        <!-- Populated with continuous 14-day bars via client script -->
                    </div>
                    <!-- Axis Baseline Labels -->
                    <div id="chart-labels" class="flex justify-between pt-2 text-[10px] font-mono text-muted">
                        <span id="chart-date-start">14 days ago</span>
                        <span id="chart-date-mid">7 days ago</span>
                        <span id="chart-date-end">Today</span>
                    </div>
                </div>
            </section>

            <!-- 3. Visitor Journeys (Clean & Readable) -->
            <section aria-label="Citizen Journeys">
                <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-main">
                            Live Visitor Journeys
                        </h2>
                        <p class="text-sm text-muted">
                            Complete step-by-step navigation path taken by each visitor with dwell times.
                        </p>
                    </div>
                </div>

                <div id="visitors-list" class="space-y-4">
                    <!-- Populated via client script -->
                </div>
            </section>

            <!-- 4. Top Pages & Referrers Grid -->
            <section class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <!-- Top Pages -->
                <div class="rounded-2xl border border-main/15 bg-muted/10 p-5 sm:p-6">
                    <h3 class="font-serif text-lg font-semibold sm:text-xl text-main mb-4">Top Pages & Views</h3>
                    <div id="top-pages-list" class="space-y-3">
                        <!-- Populated via script -->
                    </div>
                </div>

                <!-- Top Referrers -->
                <div class="rounded-2xl border border-main/15 bg-muted/10 p-5 sm:p-6">
                    <h3 class="font-serif text-lg font-semibold sm:text-xl text-main mb-4">Traffic Sources & Referrers</h3>
                    <div id="top-referrers-list" class="space-y-3">
                        <!-- Populated via script -->
                    </div>
                </div>
            </section>

            <!-- 5. Geographical & Devices Breakdown -->
            <section class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <!-- Countries -->
                <div class="rounded-2xl border border-main/15 bg-muted/10 p-5 sm:p-6">
                    <h3 class="font-serif text-lg font-semibold sm:text-xl text-main mb-4">Countries</h3>
                    <div id="countries-list" class="space-y-3">
                        <!-- Populated via script -->
                    </div>
                </div>

                <!-- Devices & Browsers -->
                <div class="rounded-2xl border border-main/15 bg-muted/10 p-5 sm:p-6">
                    <h3 class="font-serif text-lg font-semibold sm:text-xl text-main mb-4">Devices & Browsers</h3>
                    <div id="devices-list" class="space-y-3">
                        <!-- Populated via script -->
                    </div>
                </div>
            </section>
        </div>
    </article>

    <script>
        interface Step {
            id: number;
            path: string;
            title: string;
            referrer: string;
            stepOrder: number;
            dwellTimeSeconds: number;
            createdAt: number;
        }

        interface Visitor {
            id: string;
            personaName: string;
            personaAlias: string;
            personaRole: string;
            personaQuote: string;
            personaBadgeColor: string;
            personaEmoji: string;
            firstSeen: number;
            lastSeen: number;
            visitCount: number;
            totalPageViews: number;
            lastCountry: string;
            lastDevice: string;
            lastBrowser: string;
            journey: Step[];
        }

        interface TrendDay {
            date: string;
            label: string;
            views: number;
        }

        interface AnalyticsPayload {
            summary: {
                totalPageViews: number;
                uniqueVisitors: number;
                returningVisitors: number;
                topPersona: string;
            };
            visitors: Visitor[];
            topPages: Array<{ path: string; views: number }>;
            topReferrers: Array<{ referrer: string; count: number }>;
            countries: Array<{ country: string; count: number }>;
            devices: Array<{ device: string; count: number }>;
            dailyTrends: TrendDay[];
        }

        function formatTimeAgo(timestamp: number): string {
            const diff = Math.max(0, Math.floor((Date.now() - timestamp) / 1000));
            if (diff < 60) return `${diff}s ago`;
            if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
            if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
            return `${Math.floor(diff / 86400)}d ago`;
        }

        function getBadgeClass(color: string): string {
            switch (color) {
                case 'emerald': return 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border-emerald-500/30';
                case 'indigo': return 'bg-indigo-500/15 text-indigo-700 dark:text-indigo-300 border-indigo-500/30';
                case 'amber': return 'bg-amber-500/15 text-amber-700 dark:text-amber-300 border-amber-500/30';
                case 'rose': return 'bg-rose-500/15 text-rose-700 dark:text-rose-300 border-rose-500/30';
                case 'pink': return 'bg-pink-500/15 text-pink-700 dark:text-pink-300 border-pink-500/30';
                case 'purple': return 'bg-purple-500/15 text-purple-700 dark:text-purple-300 border-purple-500/30';
                case 'teal': return 'bg-teal-500/15 text-teal-700 dark:text-teal-300 border-teal-500/30';
                case 'sky': return 'bg-sky-500/15 text-sky-700 dark:text-sky-300 border-sky-500/30';
                default: return 'bg-muted text-main border-main/20';
            }
        }

        function updateMyPersonaCard() {
            const personaName = localStorage.getItem('mid_persona_name');
            const personaEmoji = localStorage.getItem('mid_persona_emoji');
            const personaQuote = localStorage.getItem('mid_persona_quote');

            if (personaName) {
                const elName = document.getElementById('my-persona-name');
                const elEmoji = document.getElementById('my-persona-emoji');
                const elQuote = document.getElementById('my-persona-quote');

                if (elName) elName.textContent = personaName;
                if (elEmoji) elEmoji.textContent = personaEmoji || '🪥';
                if (elQuote && personaQuote) elQuote.textContent = personaQuote;
            }
        }

        async function loadAnalyticsDashboard() {
            updateMyPersonaCard();

            try {
                const res = await fetch('/api/analytics/stats');
                if (!res.ok) throw new Error('Failed to load stats');
                const data: AnalyticsPayload = await res.json();

                // 1. KPI Cards
                const totalViews = data.summary.totalPageViews;
                const uniqueVisitors = data.summary.uniqueVisitors;
                const returning = data.summary.returningVisitors;
                const returnRate = uniqueVisitors > 0 ? Math.round((returning / uniqueVisitors) * 100) : 0;

                const elTotal = document.getElementById('stat-total-views');
                if (elTotal) elTotal.textContent = totalViews.toLocaleString();

                const elUnique = document.getElementById('stat-unique-visitors');
                if (elUnique) elUnique.textContent = uniqueVisitors.toLocaleString();

                const elRet = document.getElementById('stat-returning-rate');
                if (elRet) elRet.textContent = `${returnRate}%`;

                const elRetSub = document.getElementById('stat-returning-sub');
                if (elRetSub) elRetSub.textContent = `${returning.toLocaleString()} repeat visitors`;

                const elTopPersona = document.getElementById('stat-top-persona');
                if (elTopPersona) elTopPersona.textContent = data.summary.topPersona;

                // 2. Render Full 14-Day Continuous Chart Bars
                const chartContainer = document.getElementById('chart-bars');
                if (chartContainer && data.dailyTrends && data.dailyTrends.length > 0) {
                    chartContainer.innerHTML = '';
                    const maxDaily = Math.max(...(data.dailyTrends.map(t => t.views)), 1);

                    data.dailyTrends.forEach((trend, idx) => {
                        const isToday = idx === data.dailyTrends.length - 1;
                        // Height percentage with minimum floor for zero days so track is visible
                        const heightPercent = trend.views > 0 
                            ? Math.max(12, Math.round((trend.views / maxDaily) * 100))
                            : 4;

                        const barColor = trend.views > 0
                            ? (isToday ? 'bg-emerald-500' : 'bg-main/40 group-hover:bg-emerald-500')
                            : 'bg-main/10 group-hover:bg-main/20';

                        const col = document.createElement('div');
                        col.className = 'group relative flex-1 flex flex-col items-center h-full justify-end cursor-pointer';
                        col.innerHTML = `
                            <div class="w-full rounded-t ${barColor} transition-all duration-300" style="height: ${heightPercent}%"></div>
                            
                            <!-- Interactive Tooltip -->
                            <div class="pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity absolute -top-12 z-20 flex flex-col items-center">
                                <div class="rounded-md bg-main px-2 py-1 text-[11px] font-mono text-black dark:text-white shadow-lg whitespace-nowrap">
                                    <span class="font-bold">${trend.views}</span> views · ${trend.label}
                                </div>
                                <div class="h-1 w-1 border-4 border-transparent border-t-main"></div>
                            </div>
                        `;
                        chartContainer.appendChild(col);
                    });

                    // Set axis labels
                    const startLabel = document.getElementById('chart-date-start');
                    const midLabel = document.getElementById('chart-date-mid');
                    const endLabel = document.getElementById('chart-date-end');
                    if (startLabel && data.dailyTrends[0]) startLabel.textContent = data.dailyTrends[0].label;
                    if (midLabel && data.dailyTrends[6]) midLabel.textContent = data.dailyTrends[6].label;
                    if (endLabel && data.dailyTrends[13]) endLabel.textContent = `${data.dailyTrends[13].label} (Today)`;
                }

                // 3. Render Visitor Journeys
                const visitorsContainer = document.getElementById('visitors-list');
                const myVisitorId = localStorage.getItem('mid_v_id');

                if (visitorsContainer) {
                    visitorsContainer.innerHTML = '';
                    if (data.visitors.length === 0) {
                        visitorsContainer.innerHTML = `
                            <div class="rounded-xl border border-main/15 bg-muted/20 p-8 text-center text-muted">
                                No visitor journeys captured yet.
                            </div>
                        `;
                    } else {
                        data.visitors.forEach((v) => {
                            const isMe = myVisitorId && v.id === myVisitorId;
                            const item = document.createElement('div');
                            item.className = `rounded-xl border p-4 sm:p-5 transition ${
                                isMe 
                                    ? 'border-emerald-500/50 bg-emerald-500/5 ring-1 ring-emerald-500/20' 
                                    : 'border-main/15 bg-muted/20 hover:border-main/30'
                            }`;

                            // Calculate total dwell time across this visitor's session
                            const totalDwell = v.journey ? v.journey.reduce((acc, step) => acc + (step.dwellTimeSeconds || 0), 0) : 0;
                            const dwellStr = totalDwell > 60 
                                ? `${Math.floor(totalDwell / 60)}m ${totalDwell % 60}s` 
                                : `${totalDwell}s`;

                            // Build Journey breadcrumb trail
                            const journeyHtml = v.journey && v.journey.length > 0 
                                ? v.journey.map((step, idx) => `
                                    <div class="inline-flex items-center gap-1.5 py-0.5">
                                        <span class="font-mono text-xs font-medium text-main rounded bg-muted/60 px-2 py-0.5 border border-main/10">
                                            ${step.path}
                                        </span>
                                        ${step.dwellTimeSeconds > 0 ? `<span class="text-[10px] text-muted">(${step.dwellTimeSeconds}s)</span>` : ''}
                                        ${idx < v.journey.length - 1 ? '<span class="text-muted/60 text-xs mx-0.5">→</span>' : ''}
                                    </div>
                                `).join('')
                                : '<span class="text-xs text-muted">No journey steps recorded</span>';

                            item.innerHTML = `
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-main/10 pb-3">
                                    <div class="flex items-center gap-3">
                                        <span class="text-2xl">${v.personaEmoji}</span>
                                        <div>
                                            <div class="flex flex-wrap items-center gap-2">
                                                <h4 class="font-semibold text-main text-base sm:text-lg">${v.personaName}</h4>
                                                ${isMe ? '<span class="rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono text-[10px] px-2 py-0.5 font-bold uppercase">That\'s You</span>' : ''}
                                                <span class="rounded border px-2 py-0.2 text-[10px] font-mono uppercase ${getBadgeClass(v.personaBadgeColor)}">
                                                    ${v.personaRole}
                                                </span>
                                            </div>
                                            <p class="text-xs italic text-muted mt-0.5">${v.personaQuote}</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3 text-xs font-mono text-muted">
                                        <span class="rounded bg-muted/60 px-2 py-0.5 border border-main/10 text-main">
                                            ${v.visitCount} ${v.visitCount === 1 ? 'visit' : 'visits'} · ${v.totalPageViews} views
                                        </span>
                                        <span>${formatTimeAgo(v.lastSeen)}</span>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <div class="flex items-center justify-between mb-1.5">
                                        <p class="text-[11px] font-mono uppercase tracking-wider text-muted">Journey Path</p>
                                        <span class="text-[11px] font-mono text-muted">Time on site: ${dwellStr}</span>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-y-1">
                                        ${journeyHtml}
                                    </div>
                                </div>

                                <div class="mt-3 flex flex-wrap items-center gap-4 text-[11px] text-muted pt-2 border-t border-main/5 font-mono">
                                    <span>📍 ${v.lastCountry || 'Unknown'}</span>
                                    <span>💻 ${v.lastDevice || 'Desktop'}</span>
                                    <span>🌐 ${v.lastBrowser || 'Web'}</span>
                                </div>
                            `;
                            visitorsContainer.appendChild(item);
                        });
                    }
                }

                // 4. Render Top Pages with percentage bars
                const topPagesContainer = document.getElementById('top-pages-list');
                if (topPagesContainer) {
                    topPagesContainer.innerHTML = '';
                    const maxViews = Math.max(...(data.topPages.map(p => p.views)), 1);
                    data.topPages.forEach(page => {
                        const pct = Math.round((page.views / maxViews) * 100);
                        const row = document.createElement('div');
                        row.className = 'space-y-1';
                        row.innerHTML = `
                            <div class="flex justify-between text-xs font-mono">
                                <span class="text-main truncate max-w-[200px] sm:max-w-xs">${page.path}</span>
                                <span class="text-muted">${page.views.toLocaleString()}</span>
                            </div>
                            <div class="h-1.5 w-full bg-muted/30 rounded-full overflow-hidden">
                                <div class="h-full bg-main/40 rounded-full" style="width: ${pct}%"></div>
                            </div>
                        `;
                        topPagesContainer.appendChild(row);
                    });
                }

                // 5. Render Top Referrers
                const referrersContainer = document.getElementById('top-referrers-list');
                if (referrersContainer) {
                    referrersContainer.innerHTML = '';
                    data.topReferrers.forEach(ref => {
                        const row = document.createElement('div');
                        row.className = 'flex justify-between items-center text-xs font-mono py-1 border-b border-main/5';
                        row.innerHTML = `
                            <span class="text-main">${ref.referrer}</span>
                            <span class="text-muted bg-muted/40 px-2 py-0.5 rounded font-mono">${ref.count}</span>
                        `;
                        referrersContainer.appendChild(row);
                    });
                }

                // 6. Render Countries & Devices
                const countriesContainer = document.getElementById('countries-list');
                if (countriesContainer) {
                    countriesContainer.innerHTML = '';
                    data.countries.forEach(c => {
                        const row = document.createElement('div');
                        row.className = 'flex justify-between items-center text-xs font-mono py-1 border-b border-main/5';
                        row.innerHTML = `
                            <span class="text-main">📍 ${c.country}</span>
                            <span class="text-muted bg-muted/40 px-2 py-0.5 rounded font-mono">${c.count}</span>
                        `;
                        countriesContainer.appendChild(row);
                    });
                }

                const devicesContainer = document.getElementById('devices-list');
                if (devicesContainer) {
                    devicesContainer.innerHTML = '';
                    data.devices.forEach(d => {
                        const row = document.createElement('div');
                        row.className = 'flex justify-between items-center text-xs font-mono py-1 border-b border-main/5';
                        row.innerHTML = `
                            <span class="text-main">💻 ${d.device}</span>
                            <span class="text-muted bg-muted/40 px-2 py-0.5 rounded font-mono">${d.count}</span>
                        `;
                        devicesContainer.appendChild(row);
                    });
                }

                // Show Content
                const loadingEl = document.getElementById('analytics-loading');
                const contentEl = document.getElementById('analytics-content');
                if (loadingEl) loadingEl.classList.add('hidden');
                if (contentEl) contentEl.classList.remove('hidden');

            } catch (err) {
                const loadingEl = document.getElementById('analytics-loading');
                if (loadingEl) {
                    loadingEl.innerHTML = `
                        <div class="rounded-xl border border-red-500/20 bg-red-500/10 p-6 text-center text-sm text-red-600 dark:text-red-400">
                            Failed to load analytics: ${err instanceof Error ? err.message : String(err)}
                        </div>
                    `;
                }
            }
        }

        // Listen for persona-ready event from tracker
        window.addEventListener('mid:persona-ready', () => {
            updateMyPersonaCard();
        });

        // Run when page loads
        document.addEventListener('astro:page-load', () => {
            if (window.location.pathname === '/analytics' || window.location.pathname === '/analytics/') {
                loadAnalyticsDashboard();
            }
        });
    </script>
</BaseLayout>
