{
	"compatibility_date": "2026-05-12",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "alwaisy-dev",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "PAGE_VIEWS",
			"id": "7dc8853cbad6468880a6030ae47593e1"
		},
		{
			"binding": "SESSION"
		}
	],
	"d1_databases": [
		{
			"binding": "ANALYTICS_DB",
			"database_name": "alwaisy-analytics-db",
			"database_id": "82c153ca-fd6f-420b-920a-8f72b04a775a"
		}
	]
}